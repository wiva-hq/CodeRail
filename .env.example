# Copy to .env next to compose.yaml.
# Any long random string; you enter it once at /setup to create the first admin account.
SETUP_TOKEN=
# Where it listens on this machine: a port (all interfaces), or 127.0.0.1:8080 when only a proxy or tunnel on this
# machine should reach it.
LISTEN=8080
# 1 when HTTPS comes from a proxy or tunnel in front, which then must be the only way in (LISTEN=127.0.0.1:...).
TRUST_PROXY=
# Push notifications (optional): bun scripts/vapid.ts makes a pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
